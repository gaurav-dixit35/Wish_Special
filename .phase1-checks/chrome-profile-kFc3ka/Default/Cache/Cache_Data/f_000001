/* Phase 3: an intimate birthday bakery, with the cake taking centre stage. */
.cake-content { width:min(100%,740px); margin:0 auto; }
.cake-header { position:relative; z-index:1; max-width:650px; margin:0 auto; }
.cake-header .eyebrow { color:#dccbaa; letter-spacing:1.7px; }
.cake-header .eyebrow-dot { background:#ebc485; box-shadow:0 0 12px #edc88e55; }
.cake-header h1 { margin:19px auto 12px; font-size:clamp(34px,4.7vw,49px); font-weight:500; line-height:1.13; letter-spacing:-.8px; color:#f5e7d3; }
.cake-intro { max-width:430px; margin:auto; color:#b7c8e1; font-size:18px; }
.cake-art-stage { position:relative; width:min(100%,650px); margin:13px auto -9px; isolation:isolate; }
.cake-art-stage::before { content:''; position:absolute; z-index:-1; inset:5% 6% 3%; border-radius:50%; background:radial-gradient(ellipse,#a8a5e80c,transparent 70%); pointer-events:none; }
.cake-stage-glow { position:absolute; z-index:-1; inset:-8% -5% 0; border-radius:50%; background:radial-gradient(ellipse at 50% 42%,#ffca7c1c,#edb6a009 48%,transparent 72%); opacity:0; pointer-events:none; }
.cake-art { display:block; width:100%; height:auto; max-height:415px; overflow:visible; }
.cake-art-stage.is-baking { overflow:hidden; }
.cake-art .cake-body, .cake-art .cake-candle, .cake-art .cake-cherry, .cake-art .cake-flame, .cake-art .cake-smoke { transform-box:fill-box; transform-origin:center bottom; }
.cake-art .cake-sprinkle, .cake-art .cake-match, .cake-art .cake-slice { transform-box:fill-box; transform-origin:center; }
.cake-art .cake-banner, .cake-art .cake-frosting-reveal { transform-box:fill-box; transform-origin:left center; }
.cake-art-spark { position:absolute; z-index:-1; pointer-events:none; color:#e5cd9d; font:400 26px/1 var(--font-h); opacity:.65; }
.cake-art-spark-one { left:9%; top:28%; }
.cake-art-spark-two { right:10%; top:46%; color:#b8b3e9; font-size:17px; }
.cake-art-spark-three { left:15%; bottom:18%; color:#b2c9e4; font-size:17px; opacity:.35; }
.cake-step-card { position:relative; z-index:2; width:min(100%,510px); margin:0 auto 8px; padding:50px 28px 27px; background:linear-gradient(145deg,#aeb9ff11,#9790d80a); box-shadow:0 25px 70px #03061620,inset 0 1px 0 #f8e8ff08; }
.cake-guide .guide-speech { max-width:min(310px,calc(100vw - 48px)); border-color:#c7b8e54d; background:#1c2847f5; }
.cake-steps { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); align-items:start; gap:8px; margin:0 0 24px; padding:0; list-style:none; }
.cake-steps li { display:flex; flex-direction:column; align-items:center; gap:7px; min-width:0; color:#859bbd; font-size:16px; line-height:1.35; }
.cake-step-number { display:grid; place-items:center; width:29px; height:29px; border:1px solid #acc7ff2b; border-radius:50%; color:#9db0ce; font-size:16px; }
.cake-steps .is-current { color:#f3dab0; }
.cake-steps .is-current .cake-step-number { color:#ffdfa6; border-color:#dfbe7f87; background:#e6bd720e; box-shadow:0 0 18px #d9b97813; }
.cake-steps .is-done { color:#b1cdd1; }
.cake-steps .is-done .cake-step-number { color:#abdecf; border-color:#89dab346; background:#8ad4bb0c; }
.cake-step-count { margin:0 0 8px; color:#94accd; font-size:16px; }
.cake-step-count strong { color:#c8d7ed; font-weight:800; }
.cake-instruction h2 { max-width:390px; margin:0 auto 20px; color:#e5eafa; font-size:clamp(22px,3.7vw,27px); font-weight:400; line-height:1.25; letter-spacing:-.25px; }
.cake-instruction h2:focus { outline:none; }
.cake-build-controls { display:flex; flex-direction:column; align-items:center; justify-content:center; min-height:54px; }
.cake-action, .cake-tap-blow { max-width:100%; min-height:54px; padding:14px 24px; font-size:17px; line-height:1.35; }
.cake-action:disabled { cursor:default; opacity:.7; }
.cake-action:disabled::after { animation:none; }
.cake-working { display:block; color:#b3bbd9; font-size:16px; }
.cake-countdown { min-height:73px; margin:-3px auto 6px; color:#f4d199; font:500 64px/1.1 var(--font-h); }
.cake-countdown.is-blow { min-height:50px; margin:0 auto 14px; font-size:39px; letter-spacing:2px; }
.cake-blow-controls { display:flex; flex-direction:column; align-items:center; }
.cake-breath-count { margin:0 0 17px; color:#b9c9e2; font-size:16px; font-variant-numeric:tabular-nums; }
.cake-tap-blow { min-width:190px; background:linear-gradient(110deg,#bd9670,#ad8bb8 68%,#8c8fd2); box-shadow:0 7px 30px #d9b1811a,inset 0 1px 0 #fff0dc40; }
.cake-tap-blow:hover:not(:disabled) { background:linear-gradient(110deg,#cba781,#b699c0 68%,#9598dd); }
.cake-tap-blow:disabled { cursor:default; opacity:.7; }
.cake-mic-enable { margin:13px auto 0; padding:11px 10px; min-height:48px; font-size:16px; }
.cake-mic-enable:disabled { cursor:default; opacity:.7; }
.cake-mic-hint { max-width:290px; margin:6px auto 0; color:#8fa6c8; font-size:16px; line-height:1.4; }
.cake-mic-status { max-width:320px; color:#c3d4df; font-size:16px; }
.cake-mic-status:empty { display:none; }
.cake-mic-status:not(:empty) { margin:10px auto 3px; }
.cake-mic-meter { display:flex; align-items:center; justify-content:center; gap:12px; width:100%; margin:11px auto 1px; color:#a2bed5; font-size:16px; }
.cake-mic-track { display:block; width:min(110px,36%); height:5px; overflow:hidden; background:#aac7ff1f; border-radius:5px; }
.cake-mic-track i { display:block; width:100%; height:100%; background:linear-gradient(90deg,#92d7c6,#e8d69b); transform:scaleX(0); transform-origin:left center; }
.cake-completion { margin-top:-2px; }
.cake-earned { display:flex; align-items:center; justify-content:center; gap:11px; padding:14px 0 18px; border-bottom:1px solid #b3c4ee22; color:#ead6af; font-size:16px; }
.cake-earned > span:first-child { flex-shrink:0; display:grid; place-items:center; width:40px; height:40px; border:1px solid #dec38648; border-radius:50%; font-size:20px; background:#dfba6710; }
.cake-earned > span:last-child { max-width:290px; text-align:left; }
.cake-complete-text { max-width:355px; margin:19px auto 21px; color:#a8bddb; font-size:16px; line-height:1.55; }
.cake-complete-actions { display:flex; flex-direction:column; align-items:center; gap:6px; }
.cake-complete-actions .primary-button { max-width:100%; font-size:17px; padding:14px 19px; }
.cake-complete-actions .secondary-button { max-width:100%; min-height:48px; padding:12px 10px; margin:0; font-size:16px; }
.cake-back { min-height:48px; max-width:100%; padding:11px 9px; background:none; border-radius:12px; color:#93a9cb; font-size:16px; line-height:1.45; text-decoration:underline; text-decoration-color:#93a9cb4a; text-underline-offset:5px; }
.cake-back:hover { color:#c9d8ee; }
.cake-celebration { position:fixed; inset:0; z-index:15; overflow:hidden; pointer-events:none; }
.cake-streamer { position:absolute; top:-70px; display:block; width:5px; height:49px; opacity:0; }
.cake-streamer::before { content:''; display:block; width:100%; height:100%; border-radius:2px; background:linear-gradient(180deg,var(--party-color),var(--party-color) 35%,transparent); transform-origin:top center; animation:cake-streamer-sway .8s ease-in-out infinite alternate; }
.cake-streamer:nth-child(even)::before { animation-delay:-.4s; animation-duration:1.1s; }
@keyframes cake-streamer-sway { from { transform:translateX(-12px) rotate(-20deg); } to { transform:translateX(12px) rotate(20deg); } }
.cake-party-balloon { position:absolute; bottom:-125px; display:block; width:37px; height:46px; border-radius:48% 48% 47% 47%; background:radial-gradient(ellipse at 30% 27%,#fff5,transparent 35%),var(--party-color); opacity:0; }
.cake-party-balloon::before { content:''; position:absolute; left:16px; bottom:-5px; width:5px; height:7px; background:var(--party-color); clip-path:polygon(50% 0,100% 100%,0 100%); }
.cake-party-balloon::after { content:''; position:absolute; left:18px; top:50px; width:9px; height:53px; border-left:1px solid #d9d8eb66; border-radius:50%; }
@media (max-width:640px) {
  .chapter-cake { padding-top:14px; }
  .cake-header .eyebrow { letter-spacing:.9px; }
  .cake-header h1 { max-width:320px; margin-top:17px; font-size:35px; }
  .cake-intro { max-width:305px; font-size:16px; }
  .cake-art-stage { margin-top:10px; margin-bottom:8px; }
  .cake-art { max-height:none; }
  .cake-step-card { padding:44px 19px 20px; }
  .cake-steps { gap:5px; margin-bottom:15px; }
  .cake-steps li { gap:4px; }
  .cake-action, .cake-tap-blow { font-size:16px; padding:14px 19px; }
  .cake-instruction h2 { max-width:290px; margin-bottom:14px; font-size:22px; }
  .cake-art-spark-one { left:6%; }
  .cake-art-spark-two { right:6%; }
}
@media (max-width:640px) and (max-height:700px) {
  .cake-header h1 { margin:12px auto 8px; font-size:30px; }
  .cake-art-stage { margin-top:6px; margin-bottom:3px; }
  .cake-steps { margin-bottom:11px; }
  .cake-step-count { margin-bottom:5px; }
  .cake-step-card { padding-top:42px; }
  .cake-countdown.is-blow { margin-bottom:7px; font-size:32px; }
  .cake-breath-count { margin-bottom:11px; }
}
@media (max-width:360px) {
  .cake-header h1 { font-size:32px; }
  .cake-header .eyebrow { letter-spacing:.3px; }
  .cake-step-card { padding-left:13px; padding-right:13px; }
  .cake-steps { gap:3px; }
  .cake-steps li { font-size:16px; letter-spacing:-.5px; }
}
@media (prefers-reduced-motion:reduce) {
  .cake-tap-blow:active, .cake-action:active { transform:none; }
  .cake-party-balloon, .cake-streamer { display:none; }
}
