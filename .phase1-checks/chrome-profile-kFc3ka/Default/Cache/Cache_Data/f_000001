.identity-guide .guide-speech::after { bottom:auto; top:calc(50% - 5px); left:-7px; transform:rotate(135deg); }
.identity-guide .guide-speech[hidden] + .guide-live { grid-column:2; }
.identity-scan-shell { position:relative; }
.identity-scan-card { position:relative; isolation:isolate; overflow:hidden; min-height:282px; padding:60px 24px 39px; background:linear-gradient(145deg,#a6bcff12,#5681b00a); }
.identity-scan-lines { position:absolute; z-index:-1; inset:0; opacity:.3; background:repeating-linear-gradient(0deg,transparent 0 23px,#adc6ff10 23px 24px),repeating-linear-gradient(90deg,transparent 0 23px,#adc6ff10 23px 24px); }
.identity-monogram { position:relative; display:grid; place-items:center; width:74px; height:74px; margin:0 auto 15px; border:1px solid #adcdff55; border-radius:23px; color:#d9e6ff; background:linear-gradient(140deg,#93bdff26,#bca0ff18); font:500 43px/1 var(--font-h); }
.identity-monogram span { position:absolute; right:-11px; top:-12px; font-size:26px; color:#ffdb91; }
.identity-name { font-size:35px; letter-spacing:.3px; line-height:1.15; }
.identity-age { font-size:16px; color:#a4b8d8; margin-top:7px; }
.identity-laser { position:absolute; pointer-events:none; left:0; right:0; top:0; height:3px; background:linear-gradient(90deg,transparent,#a3f7e4 18%,#d7fff6 50%,#a3f7e4 82%,transparent); box-shadow:0 -4px 20px #b2ffe745,0 6px 28px #8becc94a; }
.identity-stamp { position:absolute; z-index:2; bottom:22px; right:19px; max-width:calc(100% - 38px); opacity:0; padding:7px 13px; border:2px solid #ffe09d; border-radius:8px; background:#102341e8; font:500 25px/1 var(--font-h); letter-spacing:3px; color:#ffe1a0; box-shadow:0 0 25px #ffdc9922,inset 0 0 14px #ffe09d09; }
.identity-scan-card.is-verified { border-color:#ddc18566; }
.identity-result { padding:24px 0 0; }
.identity-verified-copy { max-width:420px; margin:auto; color:#dfe9fb; font-size:18px; font-weight:800; }
.identity-stamp-earned { margin:11px auto 0; color:#efd8a9; font-size:16px; }
.identity-completion { margin-top:28px; padding-top:25px; border-top:1px solid #aac7ff20; }
